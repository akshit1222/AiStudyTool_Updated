PORT=5000
# No quotes around values
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studyforge
JWT_SECRET=<long random string>
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=<your key>

# Gmail account used to send password-reset codes (use a Gmail App Password, not your normal password)
EMAIL_USER=<you@gmail.com>
EMAIL_PASS=<gmail app password>

# Optional tuning
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_RPM=5                     # requests per minute your key/model allows (free tier is often 5-15; paid 1000+). Calls wait for a slot instead of failing with 429. Raise it to use parallel calls.
# GEMINI_THINKING_LEVEL=budget0    # budget0 = thinking off (default, fastest), minimal/low/medium/high = deeper, off = don't send the setting
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Optional: used automatically if the main model hits its daily quota (separate models have separate quotas)
# GEMINI_FALLBACK_MODEL=
